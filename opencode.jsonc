{
  "$schema": "https://opencode.ai/config.json",
  // Power BI Control Center catalog MCP server — the team uses the HOSTED
  // endpoint (see AGENTS.md "MCP server"); connect with:
  //
  //   opencode mcp add powerbi-control-center --global \
  //     --url "https://afi-powerbi-documentation-prod-app.azurewebsites.net/mcp" \
  //     --header "Authorization=Bearer <MCP_HTTP_TOKEN>"
  //
  // Deliberately NO project-level registration here: a same-named project
  // entry would shadow the global hosted one inside this repo. For local
  // stdio development use scripts/setup-mcp.ps1 -Dev instead.
}

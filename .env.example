# Power BI Control Center — environment template (names only; no real values).
# Copy to .env and populate locally. .env is gitignored — never commit real values.

# --- Azure AD app registration (required) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- Web app auth / session ---
# Auto-detected on Azure App Service (https://{hostname}/getAToken);
# local dev forces http://localhost:5000/getAToken.
REDIRECT_URI=
# Required in production (app.py has a dev-only fallback)
SECRET_KEY=
# Absolute session cap in hours (default 12)
SESSION_MAX_HOURS=12
# Optional: Redis-backed server-side sessions
# SESSION_REDIS_URL=

# --- Debug routes (disabled unless enabled) ---
# ENABLE_DEBUG_ROUTES=true

# --- Azure OpenAI (documentation generation) ---
OPENAI_API_KEY=

# --- Default Power BI targets (standalone scripts / ad hoc tests) ---
WORKSPACE_ID=
REPORT_ID=

# --- Catalog batch extract (catalog_service/catalog_config.py) ---
SCANNER_BATCH_SIZE=100
HTTP_TIMEOUT_SEC=
MAX_RETRIES=
WORKSPACE_ALLOWLIST=

# --- SharePoint artifact store (catalog source of truth) ---
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_DRIVE_NAME=
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_AGENT_FOLDER_PATH=
SHAREPOINT_UPLOAD_ENABLED=
SHAREPOINT_DECOMM_FOLDER_PATH=

# --- Catalog cache / serving ---
CATALOG_DATA_SOURCE=
CATALOG_CACHE_DIR=
CATALOG_CACHE_TTL_SEC=3600
CATALOG_KEEP_HEAVY_IN_MEMORY=false

# --- Ops snapshot / usage tracking ---
USAGE_LOOKBACK_DAYS=60
USAGE_EXCLUDE_GROUP_NAMES=
USAGE_EXCLUDE_USER_UPNS=
OPS_REFRESH_WORKERS=
OPS_USAGE_DAY_WORKERS=

# --- Catalog refresh notification (batch job -> web app) ---
CATALOG_REFRESH_SECRET=
CATALOG_APP_BASE_URL=

# --- Hosted MCP (web app proxies /mcp; start-webapp.sh runs the sidecar) ---
# REQUIRED for /mcp to serve anything: requests must carry
# "Authorization: Bearer <value>". Unset = /mcp fails closed (503).
MCP_HTTP_TOKEN=
# Per-user identity + scoping (JSON). Personal token -> UPN + workspace
# allow-list. When configured, unknown bearer tokens are rejected.
# "workspaces" present = filter to it; absent = MCP_ALLOWED_WORKSPACE_IDS.
MCP_USER_TOKENS=

# --- MCP server ACL (optional) ---
# Restrict the MCP server to specific workspaces (comma-separated GUIDs).
# Unset / all / * = tenant-wide (default). Impact-analysis tools stay
# tenant-wide by design. See AGENTS.md "MCP server".
MCP_ALLOWED_WORKSPACE_IDS=

# --- Admin Scanner run guard (scanner_connector.py) ---
# Hard ceiling (seconds) for one Admin scan run (initiate -> poll -> result).
# A stuck scanStatus poll used to hang a worker thread forever; on expiry
# run_scan returns None (callers already fall back). Default 900.
SCANNER_RUN_TIMEOUT_SEC=900

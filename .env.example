# Azure AD Application Configuration
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# OpenAI API Configuration (for AI-powered documentation generation)
OPENAI_API_KEY=your-openai-api-key-here

# Session Secret Key
SECRET_KEY=your-secret-key-here

# Redirect URI
# Local: http://localhost:5000/getAToken  (must be registered in Entra app)
# Azure: leave unset (uses WEBSITE_HOSTNAME) or set production URL
# If .env still has the Azure https://… URL while you run python app.py locally,
# the app now ignores it and forces localhost — but Entra must allow localhost.
REDIRECT_URI=http://localhost:5000/getAToken
# Local HTTP login loop fix: never force secure cookies on localhost
SESSION_COOKIE_SECURE=false


# Optional default workspace
# WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Catalog — SharePoint latest/ ONLY (no local catalog serving)
# ---------------------------------------------------------------------------
CATALOG_DATA_SOURCE=sharepoint
CATALOG_FAST_PATH_ENABLED=true
CATALOG_CACHE_TTL_SEC=3600

# Fresh full rebuild:
#   python run_catalog_extract.py --fresh -v
# Every 6 hours:
#   python run_catalog_extract.py --ops-only

# Usage (Activity Events ViewReport) — lookback for Views 60d / Zero views KPI
USAGE_LOOKBACK_DAYS=60
# Exclude internal analytics/dev viewers from view counts
# Group (Graph): needs GroupMember.Read.All; UPN fields also need User.Read.All
USAGE_EXCLUDE_GROUP_NAMES=Sg_GCC_CentralAnalytics_Unv
# Extra / override emails merged with built-in Central Analytics defaults in catalog_config
# USAGE_EXCLUDE_USER_UPNS=someone@ashleyfurnitureindia.com

SHAREPOINT_UPLOAD_ENABLED=true
SHAREPOINT_CLEAN_BEFORE_UPLOAD=true
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_HOSTNAME=yourcompany.sharepoint.com
# SHAREPOINT_SITE_PATH=/sites/BARetailAnalytics
# SHAREPOINT_DRIVE_NAME=Documents
# SHAREPOINT_FOLDER_PATH=PowerBI Reports MetaData

# ---------------------------------------------------------------------------
# Agent (/agent) — OPT-IN (default OFF). Enable only on test apps.
# Prod Control Center (Azure DevOps → afi-powerbi-documentation-prod-app):
#   leave ENABLE_AGENT unset/false
# IT Financials test App Service (GitHub):
#   ENABLE_AGENT=true
# ---------------------------------------------------------------------------
# ENABLE_AGENT=false
# AGENT_BRAIN=copilot
# From Studio embed URL:
#   .../environments/Default-<ENV_GUID>/bots/<SCHEMA>/webchat...
# COPILOTSTUDIOAGENT__ENVIRONMENTID=5a9d9cfd-c32e-4ac1-a9ed-fe83df4f9e4d
# COPILOTSTUDIOAGENT__SCHEMANAME=cr037_powerbireportcreator_PgSgoL
# Defaults to TENANT_ID / CLIENT_ID (PowerBI-Documentation-AI) if omitted:
# COPILOTSTUDIOAGENT__TENANTID=
# COPILOTSTUDIOAGENT__AGENTAPPID=
# Optional scope override (default api.powerplatform.com/.default):
# COPILOT_TOKEN_SCOPE=https://api.powerplatform.com/.default
# Requires delegated CopilotStudio.Copilots.Invoke + admin consent on the app.
# After deploy: open /login/copilot-consent once if Agent says
# "no delegated user token" (Power Platform is a separate audience from Power BI).
# DEMO_MODE=0


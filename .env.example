# ============================================================================
# POWER BI DOCUMENTATION GENERATOR - CONFIGURATION FILE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control (it contains secrets!)

# ============================================================================
# POWER BI CREDENTIALS
# ============================================================================
# These are required to connect to your Power BI workspace

# Your Power BI Application (Client) ID
# Get this from Azure Portal > App Registrations
CLIENT_ID=your-client-id-here

# Your Power BI Application Secret
# Get this from Azure Portal > App Registrations > Certificates & Secrets
CLIENT_SECRET=your-client-secret-here

# Your Microsoft Tenant ID (Organization ID)
# Get this from Azure Portal > Azure Active Directory > Overview
TENANT_ID=your-tenant-id-here

# The Power BI Workspace ID you want to document
# Get this from Power BI Service > Workspace Settings > URL
WORKSPACE_ID=your-workspace-id-here

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Required for AI-generated descriptions and analysis

# Your OpenAI API Key
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Whether to use OpenAI for AI-generated content (true/false)
# Set to false to skip AI generation and save costs
USE_OPENAI=true

# ============================================================================
# DOCUMENTATION SETTINGS
# ============================================================================

# Author name to appear in generated documents
AUTHOR_NAME=System Generated

# Folder where generated documents will be saved
OUTPUT_FOLDER=generated_docs

# Number of refresh history records to include in documentation
# Higher numbers provide more history but take longer to process
HISTORY_TOP=20

# Whether to export refresh history to CSV file (true/false)
EXPORT_REFRESH_CSV=false

# ============================================================================
# AZURE FUNCTION SETTINGS (For Webhook Integration)
# ============================================================================
# Only needed if you're using the automatic webhook-based documentation

# Your Azure Function URL (where Power BI webhooks will be sent)
# Get this after deploying your Azure Function
# Example: https://your-function.azurewebsites.net/api/webhook?code=ABC123...
AZURE_FUNCTION_URL=

# Azure Storage Account connection string (for storing documents in cloud)
# Get this from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=

# Azure Blob Container name (where documents will be stored)
AZURE_BLOB_CONTAINER=generated-docs

# ============================================================================
# MONITORING SETTINGS (For Continuous Monitoring Mode)
# ============================================================================
# Only needed if you're using the polling/monitoring mode

# How often to check for changes (in seconds)
# Default: 300 seconds (5 minutes)
MONITOR_INTERVAL_SECONDS=300

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Enable debug logging (true/false)
DEBUG=false

# Maximum number of retries for API calls
MAX_RETRIES=3

# Timeout for API calls (in seconds)
API_TIMEOUT=60


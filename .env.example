# Azure AD Application Configuration
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# OpenAI API Configuration (for AI-powered documentation generation)
OPENAI_API_KEY=your-openai-api-key-here

# Session Secret Key (MUST be stable across App Service restarts — never rotate per deploy without logging users out)
SECRET_KEY=your-secret-key-here

# Redirect URI
# Local: http://localhost:5000/getAToken  (must be registered in Entra app)
# Azure: leave unset (uses WEBSITE_HOSTNAME) or set production URL
# If .env still has the Azure https://… URL while you run python app.py locally,
# the app now ignores it and forces localhost — but Entra must allow localhost.
REDIRECT_URI=http://localhost:5000/getAToken
# Local HTTP login loop fix: never force secure cookies on localhost
SESSION_COOKIE_SECURE=false
# Filesystem session pruning threshold (default 10000). Old 500 caused OAuth state loss under load.
# SESSION_FILE_THRESHOLD=10000
# Optional Redis session store (recommended on Azure). When set, used instead of filesystem.
# Requires package: redis
# SESSION_REDIS_URL=rediss://:password@your-cache.redis.cache.windows.net:6380/0

# After ops/fresh publish, extract can POST the App Service to reload catalog cache.
# Same secret must be set on App Service Application Settings.
# CATALOG_REFRESH_SECRET=long-random-string
# CATALOG_APP_BASE_URL=https://afi-powerbi-documentation-prod-app.azurewebsites.net
# CATALOG_REFRESH_NOTIFY_DELAY_SEC=3
# CATALOG_REFRESH_NOTIFY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Decommissioned Reports → Overview tab (Power BI embed)
# Defaults point at Fabric Admin Governance programme report; override if moved.
# Embed uses the signed-in user's token (GenerateToken). Detail tab never needs this.
# ---------------------------------------------------------------------------
# DECOMM_DASHBOARD_WORKSPACE_ID=943b84dc-a22b-4f4f-8434-74396e772de1
# DECOMM_DASHBOARD_REPORT_ID=5e4eb1ff-26b8-47d5-84ab-cecadcbb0c3f
# Dataset id for "Sync data" → POST refreshes (optional; resolved from report if empty)
# DECOMM_DASHBOARD_DATASET_ID=
# DECOMM_DASHBOARD_SERVICE_URL=https://app.powerbi.com/groups/.../reports/.../Overview?experience=power-bi
# DECOMM_DASHBOARD_EMBED=true
# DECOMM_DASHBOARD_TITLE=Power BI Estate Decommissioning Programme
# Stable SharePoint folder for Power BI Get Data (default: …/Report Decommission Activity/_dataset_feed)
# DECOMM_DATASET_FEED_FOLDER=
# DECOMM_DATASET_FEED_XLSX_NAME=Decommissioned_Inventory_Latest.xlsx
# DECOMM_DATASET_FEED_CSV_NAME=Decommissioned_Inventory_Latest.csv


# Optional default workspace
# WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Catalog — SharePoint latest/ ONLY (no local catalog serving)
# ---------------------------------------------------------------------------
CATALOG_DATA_SOURCE=sharepoint
CATALOG_FAST_PATH_ENABLED=true
CATALOG_CACHE_TTL_SEC=3600

# Fresh full rebuild:
#   python run_catalog_extract.py --fresh -v
# Every 6 hours:
#   python run_catalog_extract.py --ops-only

# Usage (Activity Events ViewReport) — lookback for Views 60d / Zero views KPI
USAGE_LOOKBACK_DAYS=60
# Exclude internal analytics/dev viewers from view counts
# Group (Graph): needs GroupMember.Read.All; UPN fields also need User.Read.All
USAGE_EXCLUDE_GROUP_NAMES=Sg_GCC_CentralAnalytics_Unv
# Extra / override emails merged with built-in Central Analytics defaults in catalog_config
# USAGE_EXCLUDE_USER_UPNS=someone@ashleyfurnitureindia.com

SHAREPOINT_UPLOAD_ENABLED=true
SHAREPOINT_CLEAN_BEFORE_UPLOAD=true
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_HOSTNAME=yourcompany.sharepoint.com
# SHAREPOINT_SITE_PATH=/sites/BARetailAnalytics
# SHAREPOINT_DRIVE_NAME=Documents
# SHAREPOINT_FOLDER_PATH=PowerBI Reports MetaData
